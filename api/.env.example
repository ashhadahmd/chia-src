SECRET_KEY=change-me
MCP_API_KEY=change-me
ROOT_EMAIL=root@example.com
ROOT_USERNAME=root
ROOT_PASSWORD=change-me
DATABASE_URL=sqlite:///./chia.db
CORS_ORIGINS=["http://localhost:5173"]

# Google Workspace (create an OAuth client at console.cloud.google.com; leave empty for local-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
# Optional: Google Picker for "Import › Pick from Google Drive" (API key + Cloud project number)
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# Database: SQLite locally; postgresql+psycopg://user:pass@host/db in AWS.
# Migrations run on startup unless AUTO_MIGRATE=false (then run `uv run alembic upgrade head`).
AUTO_MIGRATE=true

# Image storage: local (./.local_storage, no AWS needed) or s3 (presigned URLs)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_REGION=
# Document bodies bigger than this (bytes of JSON) are gzipped into the storage above
INLINE_CONTENT_MAX_BYTES=65536

# Realtime notices: local (/api/ws only) or aws_appsync (also AppSync Events, for Lambda)
REALTIME_BACKEND=local
APPSYNC_HTTP_ENDPOINT=
APPSYNC_REALTIME_ENDPOINT=
APPSYNC_NAMESPACE=chia
# Dev only; leave empty in production (IAM publishing + the Lambda authorizer for browsers)
APPSYNC_API_KEY=

# Hosts MCP clients reach the API by besides localhost, e.g. ["api.example.com"]
MCP_ALLOWED_HOSTS=[]

# Google Drive backup runner: local (inside the API) or external (app.worker on Lambda/cron)
DRIVE_SYNC_RUNNER=local
